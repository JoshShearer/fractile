#!/usr/bin/env python3
"""Launcher for the Fractile UI. Finds the fractile_ui package next to this
script (development tree) or in the installed location."""
import os
import sys

here = os.path.dirname(os.path.realpath(__file__))
for cand in (here, os.path.join(here, "..", "lib", "fractile"), "/usr/lib/fractile", "/usr/local/lib/fractile"):
    if os.path.isdir(os.path.join(cand, "fractile_ui")):
        sys.path.insert(0, os.path.abspath(cand))
        break

from fractile_ui.app import main  # noqa: E402

sys.exit(main(sys.argv))
