[Desktop Entry]
Type=Application
Name=Fractile
GenericName=Window Grid and Session Restore
Comment=Place windows on a grid and restore your workspace after a restart
Exec=fractile-ui --launcher
Icon=io.fractile.Fractile
Terminal=false
Categories=Utility;Qt;
Keywords=window;tile;grid;snap;layout;session;restore;divvy;
StartupNotify=false
Actions=Settings;Dashboard;Palette;

[Desktop Action Settings]
Name=Settings
Exec=fractile-ui --settings

[Desktop Action Dashboard]
Name=Workspace Dashboard
Exec=fractile-ui --dashboard

[Desktop Action Palette]
Name=Command Palette
Exec=fractile-ui --palette
